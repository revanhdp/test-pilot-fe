# Clerk publishable key (dashboard.clerk.com → API keys). The secret key goes in the API's .env.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Only when the API is on another origin than the web app (production, no shared Nginx).
# Leave empty to call /api on the same origin. Needs the origin in the API's APP_URL.
NUXT_PUBLIC_API_BASE=
